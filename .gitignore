.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# per-machine data (keys live in ~/.config/warstudio, never here)
.env
projects/*
!projects/.gitkeep
library/raw/*
!library/raw/.gitkeep
# the shot library (index.db, shots, keyframes, backups) is per-machine data - never in git
library/shots/*
!library/shots/.gitkeep
data/*
!data/.gitkeep
assets/sfx/_generated/
assets/sfx/*/*
!assets/sfx/*/.gitkeep
assets/music/*
!assets/music/.gitkeep
